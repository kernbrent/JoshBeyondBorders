{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "josh-beyond-borders-admin-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "joshbeyondborders.org/api/admin/*",
      "zone_name": "joshbeyondborders.org"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://joshbeyondborders.org",
    "GITHUB_OWNER": "kernbrent",
    "GITHUB_REPO": "JoshBeyondBorders",
    "GITHUB_BRANCH": "main",
    "WORKBOOK_PATH": "admin/resources/giving-workbook.enc.json",
    "PROGRESS_PATH": "data/giving-progress.json",
    "GIVING_GOAL": "7500",
    "PAYPAL_ITEM_TITLE": "Josh Beyond Borders Donation",
    "PAYPAL_ITEM_ID": "BeyondBorders",
    "PAYPAL_RECEIVER_EMAIL": "christianstepsministries@gmail.com",
    "PAYPAL_LOOKBACK_DAYS": "93"
  },
  "secrets": {
    "required": ["GITHUB_TOKEN", "PAYPAL_CLIENT_ID", "PAYPAL_CLIENT_SECRET", "CSM_DISTRIBUTION_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "josh-beyond-borders-admin",
      "database_id": "677d3d57-9c65-4679-92d7-6d011b0fc5d3",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    { "binding": "CSM_STATUS", "service": "christian-steps-admin-api" }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
